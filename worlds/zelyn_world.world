  <world name="zelyn_world">
    <gui>
      <camera name="user_camera">
        <pose>-4292 -3835 12 0 0.2 -0.808</pose>
      </camera>
    </gui>
    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.65 0.80 1.0 1</background>
      <shadows>true</shadows>
      <sky>
        <time>12</time>
        <clouds>
          <enable>1</enable>
          <speed>0.6</speed>
          <direction>0</direction>
          <humidity>0.2</humidity>
          <mean_size>0.5</mean_size>
        </clouds>
      </sky>
    </scene>

    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>

    <include>
      <uri>model://zelyn_ground</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>40.39827777777778</latitude_deg>
      <longitude_deg>109.51380555555555</longitude_deg>
      <elevation>9.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>



